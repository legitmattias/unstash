# Reverse proxy site for one Unstash environment.
#
# Copy to /etc/caddy/sites/<environment>.caddy on the host and replace
# UNSTASH_DOMAIN, ENVIRONMENT, API_PORT and WEB_PORT. The ports are the loopback ports the
# environment's compose override publishes (`ports:` under api and frontend).
#
# The application derives the client address for rate limiting from the last
# X-Forwarded-For entry, so exactly one proxy must sit in front of it. Caddy
# discards a client-supplied X-Forwarded-For unless `trusted_proxies` is
# configured; leave it unset.

UNSTASH_DOMAIN {
	encode zstd gzip

	# API — all /api/* requests go to the FastAPI backend.
	handle /api/* {
		reverse_proxy 127.0.0.1:API_PORT
	}

	# Frontend — everything else goes to the Next.js server.
	handle {
		reverse_proxy 127.0.0.1:WEB_PORT
	}

	log {
		output file /var/log/caddy/ENVIRONMENT-access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
