# Non-sensitive environment configuration.
# Copy to .env and edit as needed. Secrets go in ./secrets/ as files, NOT here.

# Runtime environment: development | staging | production
UNSTASH_ENVIRONMENT=development

# Logging level
UNSTASH_LOG_LEVEL=INFO

# SvelteKit origin (used for CSRF protection)
ORIGIN=http://localhost:3000

# Maximum upload size per document, in bytes (default 100 MiB)
#UNSTASH_MAX_UPLOAD_BYTES=104857600

# Embedding backend: jina (real API) | fake (deterministic, for tests)
#UNSTASH_EMBEDDER_BACKEND=jina

# OCR backend for scanned PDFs: mistral | off (off fails scans with an actionable error)
#UNSTASH_OCR_BACKEND=off

# Below this average of extracted chars per page, a PDF is treated as scanned
#UNSTASH_OCR_MIN_CHARS_PER_PAGE=200

# Service URLs (defaults shown; only override for non-standard setups)
#UNSTASH_GOTENBERG_URL=http://gotenberg:3000
#UNSTASH_JINA_BASE_URL=https://api.jina.ai/v1
#UNSTASH_MISTRAL_BASE_URL=https://api.mistral.ai
